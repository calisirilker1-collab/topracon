var GRUP={ana:"Takip",saha:"Saha operasyonu",karbon:"MRV / VM0042",yon:"Yönetim"};

function el(i){return document.getElementById(i)}
function esc(x){return String(x==null?"":x).replace(/[&<>"]/g,function(c){
  return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function n0(x){return (x==null||x==="")?"—":Number(x).toLocaleString("tr-TR",{maximumFractionDigits:0})}
function n1(x){return (x==null||x==="")?"—":Number(x).toLocaleString("tr-TR",{maximumFractionDigits:1})}
function tl(x){return (x==null||x==="")?"—":Number(x).toLocaleString("tr-TR",{maximumFractionDigits:0})+" ₺"}
function toast(m,bad){var t=el("toast");t.textContent=m;t.className="toast on"+(bad?" bad":"");
  clearTimeout(t._x);t._x=setTimeout(function(){t.className="toast"},3400)}
function dTR(s){if(!s)return "—";var d=new Date(s);
  return d.toLocaleDateString("tr-TR",{day:"2-digit",month:"2-digit",year:"2-digit"})}
function dtTR(s){if(!s)return "—";var d=new Date(s);
  return dTR(s)+" "+d.toLocaleTimeString("tr-TR",{hour:"2-digit",minute:"2-digit"})}
function durumAd(k){var f=DURUM.filter(function(d){return d[0]===k})[0];return f?f[1]:(k||"—")}
function pill(v,lab){return '<span class="pill p-'+esc(v||"")+'">'+esc(lab||v||"—")+'</span>'}
function bugun(){return new Date().toISOString().slice(0,10)}
function isYon(){return ME&&ME.rol==="yonetici"}
function param(k,d){var p=PARAM.filter(function(x){return x.anahtar===k})[0];
  return p&&!isNaN(+p.deger)?+p.deger:d}
function kpiBox(v,l,c){return '<div class="kpi '+c+'"><div class="v">'+v+'</div><div class="l">'+l+'</div></div>'}
function ciftciAd(id){var c=CIFTCI.filter(function(x){return x.id===id})[0];return c?c.ad_soyad:"—"}
function parselOf(id){return PARSEL.filter(function(x){return x.id===id})[0]}
function parselleriOf(cid){return PARSEL.filter(function(p){return p.ciftci_id===cid})}
function state(box,tbl,on,t,s){el(box).style.display=on?"block":"none";
  if(on)el(box).innerHTML="<h3>"+esc(t)+"</h3><p>"+esc(s)+"</p>";
  var e=el(tbl); if(e)e.style.display=on?"none":"";}

function api(path,opts){
  opts=opts||{};
  var h={"apikey":SB_KEY,"Content-Type":"application/json"};
  if(TOKEN) h["Authorization"]="Bearer "+TOKEN;
  if(opts.prefer) h["Prefer"]=opts.prefer;
  return fetch(SB_URL.replace(/\/+$/,"")+path,{method:opts.method||"GET",headers:h,body:opts.body})
    .then(function(r){
      if(r.status===401||r.status===403) throw {auth:true,msg:"Yetki reddedildi"};
      if(!r.ok) return r.text().then(function(t){throw {msg:r.status+" "+t}});
      if(r.status===204) return null;
      return r.text().then(function(t){return t?JSON.parse(t):null});
    });
}
function hata(e){
  if(e&&e.auth){toast("Oturum düştü, tekrar giriş yapın.",true);logout();return}
  toast("İşlem başarısız: "+((e&&e.msg)||"bilinmeyen hata"),true);
  console.error("[Topracon]",e);
}
function patch(path,body,ok,btn,lab){
  api(path,{method:"PATCH",body:JSON.stringify(body),prefer:"return=representation"})
   .then(function(r){if(btn){btn.disabled=false;btn.textContent=lab}ok(r&&r[0])})
   .catch(function(e){if(btn){btn.disabled=false;btn.textContent=lab}hata(e)});
}
function post(path,body,ok,btn,lab){
  api(path,{method:"POST",body:JSON.stringify(body),prefer:"return=representation"})
   .then(function(r){if(btn){btn.disabled=false;btn.textContent=lab}ok(r&&r[0])})
   .catch(function(e){if(btn){btn.disabled=false;btn.textContent=lab}hata(e)});
}

/* ---------- giriş ---------- */
el("lf").addEventListener("submit",function(ev){
  ev.preventDefault();
  var mail=el("lMail").value.trim(),pw=el("lPw").value,m=el("lMsg");
  if(!SB_URL||!SB_KEY){m.className="msg info on";
    m.innerHTML="Supabase bağlantısı tanımlı değil. Dosyanın üstündeki <b>SB_URL</b> ve <b>SB_KEY</b> satırlarını doldurun.";return}
  if(!mail||!pw){m.className="msg bad on";m.textContent="E-posta ve şifre gerekli.";return}
  var b=el("lBtn");b.disabled=true;b.textContent="Giriş yapılıyor…";m.className="msg";
  fetch(SB_URL.replace(/\/+$/,"")+"/auth/v1/token?grant_type=password",{
    method:"POST",headers:{"apikey":SB_KEY,"Content-Type":"application/json"},
    body:JSON.stringify({email:mail,password:pw})})
  .then(function(r){return r.json().then(function(j){return {ok:r.ok,j:j}})})
  .then(function(res){
    if(!res.ok||!res.j.access_token) throw new Error(res.j.error_description||res.j.msg||"Giriş başarısız");
    TOKEN=res.j.access_token;
    return api("/rest/v1/personel?select=ad_soyad,rol,bolge&limit=1");
  })
  .then(function(p){
    if(!p||!p.length){TOKEN=null;throw new Error("Bu hesap personel olarak tanımlı değil. Yöneticinizle görüşün.")}
    ME=p[0];
    el("meName").textContent=ME.ad_soyad;
    el("meRole").textContent=({yonetici:"Yönetici",muhendis:"Ziraat mühendisi",operasyon:"Operasyon"})[ME.rol]
      +(ME.bolge?" · "+ME.bolge:"");
    el("loginWrap").style.display="none";el("app").style.display="block";
    buildNav();loadAll();
  })
  .catch(function(e){
    b.disabled=false;b.textContent="Giriş yap";
    var m=el("lMsg");m.className="msg bad on";
    m.textContent=(e&&e.message)||"Giriş yapılamadı.";
  });
});
function logout(){
  TOKEN=null;ME=null;BASVURU=[];CIFTCI=[];PARSEL=[];AKTIVITE=[];ODEME=[];PERSONEL=[];PARAM=[];
  el("app").style.display="none";el("loginWrap").style.display="flex";el("lPw").value="";
  var b=el("lBtn");b.disabled=false;b.textContent="Giriş yap";el("lMsg").className="msg";
}

/* ---------- gezinme ---------- */
function buildNav(){
  var h="",son="";
  MENU.forEach(function(m){
    if(m[2]==="yon"&&!isYon())return;
    if(m[2]!==son){h+='<div class="grp">'+GRUP[m[2]]+'</div>';son=m[2]}
    h+='<button data-v="'+m[0]+'" onclick="go(\''+m[0]+'\')" aria-current="'+(m[0]==="ozet")+'">'
      +m[1]+'<span class="bdg" id="bdg-'+m[0]+'" style="display:none"></span></button>';
  });
  el("nav").innerHTML=h;
}
function go(v){
  MENU.forEach(function(m){var e=el("v-"+m[0]);if(e)e.classList.toggle("on",m[0]===v)});
  Array.prototype.forEach.call(el("nav").querySelectorAll("button"),function(b){
    b.setAttribute("aria-current",String(b.dataset.v===v))});
  window.scrollTo(0,0);
}
function bdg(v,n){var e=el("bdg-"+v);if(!e)return;
  if(n>0){e.textContent=n;e.style.display=""}else e.style.display="none"}

/* ---------- veri ---------- */
function loadAll(){
  var J=[
   api("/rest/v1/basvuru?select=*&order=olusturma.desc&limit=2000").then(function(r){BASVURU=r||[]}),
   api("/rest/v1/ciftci?select=*&order=olusturma.desc&limit=2000").then(function(r){CIFTCI=r||[]}).catch(function(){CIFTCI=[]}),
   api("/rest/v1/parsel?select=*&order=olusturma.desc&limit=4000").then(function(r){PARSEL=r||[]}).catch(function(){PARSEL=[]}),
   api("/rest/v1/aktivite?select=*&order=tarih.desc&limit=4000").then(function(r){AKTIVITE=r||[]}).catch(function(){AKTIVITE=[]}),
   api("/rest/v1/odeme?select=*&order=planlanan_tarih.desc&limit=4000").then(function(r){ODEME=r||[]}).catch(function(){ODEME=[]}),
   api("/rest/v1/parametre?select=*&order=anahtar").then(function(r){PARAM=r||[]}).catch(function(){PARAM=[]})
  ];
  if(isYon())J.push(api("/rest/v1/personel?select=*&order=olusturma").then(function(r){PERSONEL=r||[]}).catch(function(){PERSONEL=[]}));
  Promise.all(J).then(function(){
    drawOzet();drawBasvuru();drawCiftci();drawParsel();drawAktivite();drawOdeme();drawPersonel();drawAyar();drawKarbonViews();
  }).catch(hata);
}

/* ---------- genel bakış ---------- */
function drawOzet(){
  var yeni=BASVURU.filter(function(r){return r.durum==="yeni"}).length;
  var uye=CIFTCI.filter(function(c){return c.durum==="aktif"}).length;
  var pAktif=PARSEL.filter(function(p){return p.durum==="aktif"});
  var donum=pAktif.reduce(function(a,p){return a+Number(p.donum||0)},0);
  var cel=AKTIVITE.filter(function(a){return a.dogrulama==="celiski"}).length;
  var bek=AKTIVITE.filter(function(a){return a.dogrulama==="bekliyor"}).length;
  var acik=ODEME.filter(function(o){return o.durum==="planlandi"||o.durum==="onayda"});
  var gec=acik.filter(function(o){return o.planlanan_tarih&&o.planlanan_tarih<bugun()}).length;

  el("ozetKpi").innerHTML=kpiBox(yeni,"yeni başvuru","k-yeni")+kpiBox(uye,"aktif üye","k-uye")
    +kpiBox(n0(donum),"aktif dönüm","k-field")+kpiBox(cel,"uydu çelişkisi","k-alert")
    +kpiBox(bek,"doğrulama bekliyor","k-analiz")+kpiBox(gec,"geciken ödeme","k-alert")
    +kpiBox(tl(acik.reduce(function(a,o){return a+Number(o.tutar||0)},0)),"ödenmemiş tutar","k-sozlesme");
  bdg("basvuru",yeni);bdg("defter",cel);bdg("odeme",gec);

  var say={};DURUM.forEach(function(d){say[d[0]]=0});
  BASVURU.forEach(function(r){if(say[r.durum]!==undefined)say[r.durum]++});
  var max=Math.max(1,say.yeni,say.arandi,say.analiz,say.sozlesme,say.uye);
  el("huni").innerHTML=["yeni","arandi","analiz","sozlesme","uye"].map(function(k,i){
    return '<div class="fu"><span class="lab">'+durumAd(k)+'</span><span class="bar b'+(i+1)
      +'" style="width:'+(say[k]/max*68+2)+'%"></span><span class="n">'+say[k]+'</span></div>'}).join("");

  var isler=[];
  if(yeni)isler.push(["Aranmayı bekleyen başvuru",yeni,"basvuru"]);
  if(cel)isler.push(["Uydu ile çelişen defter kaydı",cel,"defter"]);
  if(bek)isler.push(["Doğrulanmamış defter kaydı",bek,"defter"]);
  if(gec)isler.push(["Tarihi geçmiş ödeme",gec,"odeme"]);
  var eksik=pAktif.filter(function(p){return !p.baz_soc}).length;
  if(eksik)isler.push(["Baz toprak analizi girilmemiş parsel",eksik,"parsel"]);
  var kv=BASVURU.filter(function(r){return r.kvkk_onay===false}).length;
  if(kv)isler.push(["KVKK onayı olmayan başvuru",kv,"basvuru"]);
  el("isler").innerHTML=isler.length?isler.map(function(x){
    return '<button class="kpi k-alert" style="margin-bottom:8px" onclick="go(\''+x[2]+'\')">'
      +'<div class="v">'+x[1]+'</div><div class="l">'+esc(x[0])+'</div></button>'}).join("")
    :'<p class="tiny">Bekleyen iş yok. Hat temiz.</p>';

  var il={};
  BASVURU.forEach(function(r){var k=r.il||"—";il[k]=il[k]||{b:0,u:0,d:0};il[k].b++});
  CIFTCI.forEach(function(c){var k=c.il||"—";il[k]=il[k]||{b:0,u:0,d:0};il[k].u++});
  PARSEL.forEach(function(p){var k=p.il||"—";il[k]=il[k]||{b:0,u:0,d:0};il[k].d+=Number(p.donum||0)});
  var ks=Object.keys(il).sort(function(a,b){return il[b].b-il[a].b});
  el("ilTablo").innerHTML=ks.length?ks.map(function(k){
    return '<tr><td>'+esc(k)+'</td><td class="r num">'+il[k].b+'</td><td class="r num">'+il[k].u
      +'</td><td class="r num">'+n0(il[k].d)+'</td></tr>'}).join("")
    :'<tr><td colspan="4" class="dim">Henüz veri yok.</td></tr>';
  el("ozetSub").textContent="Son yenileme "+dtTR(new Date().toISOString())+" · "
    +BASVURU.length+" başvuru, "+CIFTCI.length+" üye, "+PARSEL.length+" parsel.";
}

/* ---------- başvurular ---------- */
var BCOL=[["olusturma","Tarih"],["ad_soyad","Ad soyad"],["telefon","Telefon"],["il","İl / ilçe"],
          ["donum","Dönüm",1],["urun","Ürün"],["toprak_isleme","Toprak işleme"],["durum","Durum"],
          ["atanan_muhendis","Mühendis"]];
function drawBasvuru(){
  var say={};DURUM.forEach(function(d){say[d[0]]=0});var alan=0;
  BASVURU.forEach(function(r){if(say[r.durum]!==undefined)say[r.durum]++;
    if(r.durum!=="vazgecti"&&r.durum!=="uygun-degil")alan+=Number(r.donum||0)});
  var cells=[["","Tümü",BASVURU.length,"k-arandi"]];
  ["yeni","arandi","analiz","sozlesme","uye"].forEach(function(k){cells.push([k,durumAd(k),say[k],"k-"+k])});
  el("bKpi").innerHTML=cells.map(function(c){
    return '<button class="kpi '+c[3]+'" aria-pressed="'+(bDurum===c[0])+'" onclick="setBDurum(\''+c[0]+'\')">'
      +'<div class="v">'+c[2]+'</div><div class="l">'+esc(c[1])+'</div></button>'}).join("")
    +kpiBox(n0(alan),"hattaki dönüm","k-field");

  var ill={};BASVURU.forEach(function(r){if(r.il)ill[r.il]=1});
  var cur=el("bIl").value;
  el("bIl").innerHTML='<option value="">Tüm iller</option>'
    +Object.keys(ill).sort().map(function(i){return '<option>'+esc(i)+'</option>'}).join("");
  el("bIl").value=cur;

  var q=el("bQ").value.trim().toLowerCase(),il=el("bIl").value,onc=el("bOnc").value;
