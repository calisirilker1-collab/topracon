<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Topracon Yönetim — Başvurular</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 22 22'%3E%3Crect width='22' height='5' fill='%23D8C69A'/%3E%3Crect y='5' width='22' height='6' fill='%23A66F4F'/%3E%3Crect y='11' width='22' height='5' fill='%237A4F38'/%3E%3Crect y='16' width='22' height='6' fill='%2326342B'/%3E%3C/svg%3E">
<meta name="theme-color" content="#26342B">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --soil:#26342B; --field:#607A55; --clay:#A66F4F; --wheat:#D8C69A;
  --paper:#F4F1E8; --paper2:#FBF9F3; --signal:#D6A928; --alert:#8E4A32; --ink:#1C2620;
  --line:rgba(28,38,32,.16); --line2:rgba(28,38,32,.08);
  --disp:"Manrope","Segoe UI",system-ui,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--disp);font-size:15px;
  line-height:1.5;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{margin:0;font-weight:800;letter-spacing:-.025em;line-height:1.15}
h1{font-size:1.5rem}h2{font-size:1.1rem}h3{font-size:1rem}h4{font-size:.92rem}
p{margin:0}
button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}
a{color:inherit}
:focus-visible{outline:2.5px solid var(--field);outline-offset:2px;border-radius:4px}
.mono,.num{font-family:var(--mono);font-feature-settings:"tnum" 1}

/* ---------- giriş ---------- */
.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:#1B241E;padding:20px}
.login{width:100%;max-width:400px;background:var(--paper);border-radius:14px;overflow:hidden}
.login .head{background:var(--soil);color:var(--paper);padding:24px 24px 26px}
.login .head .mark{display:flex;align-items:center;gap:9px;font-weight:800;font-size:1.1rem;
  letter-spacing:-.035em}
.logo{display:flex;flex-direction:column;width:18px;flex:none}
.logo i{display:block;height:4.5px}
.login .head h1{margin-top:16px;color:#FBF9F3;font-size:1.35rem}
.login .head p{margin-top:7px;font-size:.9rem;color:rgba(216,198,154,.82)}
.login .body{padding:22px 24px 26px}
label.f{display:block;font-size:.85rem;font-weight:700;margin-bottom:6px}
input,select,textarea{width:100%;padding:11px 12px;border:1.5px solid var(--line);border-radius:8px;
  background:#fff;font:inherit;font-size:.96rem;color:var(--ink)}
textarea{min-height:88px;resize:vertical;line-height:1.5}
input.err{border-color:var(--alert);background:#FBF3EF}
.field+.field{margin-top:14px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;
  padding:0 20px;border-radius:8px;background:var(--field);color:#FBF9F3;font-weight:700;
  font-size:.96rem}
.btn:hover{background:#4E6746}
.btn.soil{background:var(--soil);color:var(--paper)}
.btn.ghost{background:transparent;border:1.5px solid var(--line);color:var(--ink)}
.btn.ghost:hover{background:rgba(28,38,32,.05)}
.btn.danger{background:transparent;border:1.5px solid rgba(142,74,50,.5);color:var(--alert)}
.btn.block{width:100%}
.btn.sm{min-height:36px;padding:0 14px;font-size:.88rem;border-radius:6px}
.btn[disabled]{opacity:.45;cursor:default}
.msg{display:none;margin-top:14px;padding:11px 13px;border-radius:8px;font-size:.9rem;font-weight:500}
.msg.on{display:block}
.msg.bad{background:rgba(142,74,50,.12);color:var(--alert)}
.msg.info{background:rgba(214,169,40,.16);color:#7A5F10}
.tiny{font-size:.82rem;color:rgba(28,38,32,.58);line-height:1.45}

/* ---------- uygulama ---------- */
#app{display:none}
.bar{background:var(--soil);color:var(--paper);position:sticky;top:0;z-index:40}
.bar-in{max-width:1500px;margin:0 auto;padding:0 20px;height:58px;display:flex;align-items:center;gap:14px}
.bar .mark{display:flex;align-items:center;gap:9px;font-weight:800;font-size:1.06rem;letter-spacing:-.035em}
.bar .env{font-family:var(--mono);font-size:.66rem;text-transform:uppercase;letter-spacing:.08em;
  background:rgba(214,169,40,.24);color:var(--signal);padding:3px 7px;border-radius:4px;font-weight:600}
.bar .sp{margin-left:auto}
.bar .me{font-size:.85rem;color:rgba(216,198,154,.85);text-align:right;line-height:1.3}
.bar .me b{display:block;color:#FBF9F3;font-weight:700}
.bar button{border:1px solid rgba(244,241,232,.32);border-radius:6px;padding:7px 12px;font-size:.85rem;
  font-weight:600}
.bar button:hover{background:rgba(244,241,232,.12)}
.wrap{max-width:1500px;margin:0 auto;padding:20px}

.kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:18px}
@media(max-width:1100px){.kpis{grid-template-columns:repeat(3,1fr)}}
@media(max-width:640px){.kpis{grid-template-columns:repeat(2,1fr)}}
.kpi{background:var(--paper2);border:1px solid var(--line);border-left:4px solid var(--clay);
  border-radius:8px;padding:12px 14px;text-align:left;width:100%}
.kpi:hover{border-color:var(--clay)}
.kpi[aria-pressed="true"]{background:var(--soil);border-color:var(--soil)}
.kpi[aria-pressed="true"] .v{color:#FBF9F3}
.kpi[aria-pressed="true"] .l{color:rgba(216,198,154,.8)}
.kpi .v{font-family:var(--mono);font-weight:600;font-size:1.5rem;letter-spacing:-.03em;line-height:1}
.kpi .l{font-size:.76rem;color:rgba(28,38,32,.62);margin-top:5px}
.kpi.d-yeni{border-left-color:var(--signal)}
.kpi.d-arandi{border-left-color:var(--clay)}
.kpi.d-analiz{border-left-color:#8A9A64}
.kpi.d-sozlesme{border-left-color:var(--field)}
.kpi.d-uye{border-left-color:var(--soil)}
.kpi.d-alan{border-left-color:#7A4F38}

.tools{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
.tools input,.tools select{padding:9px 11px;font-size:.9rem;min-height:40px;width:auto}
.tools .grow{flex:1;min-width:200px}
.count{font-family:var(--mono);font-size:.82rem;color:rgba(28,38,32,.6)}

.tablebox{background:var(--paper2);border:1px solid var(--line);border-radius:8px;overflow:hidden}
.scroll{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:.88rem}
th{text-align:left;font-family:var(--mono);font-size:.68rem;text-transform:uppercase;
  letter-spacing:.06em;color:rgba(28,38,32,.55);font-weight:600;padding:11px 12px;
  border-bottom:1px solid var(--line);white-space:nowrap;background:var(--paper2);
  position:sticky;top:0;cursor:pointer;user-select:none}
th:hover{color:var(--ink)}
th .ar{opacity:.4}
td{padding:11px 12px;border-bottom:1px solid var(--line2);vertical-align:middle}
tbody tr{cursor:pointer}
tbody tr:hover{background:rgba(28,38,32,.04)}
tbody tr.sel{background:rgba(214,169,40,.14)}
td.r{text-align:right}
.nowrap{white-space:nowrap}
.pill{display:inline-flex;align-items:center;gap:5px;font-family:var(--mono);font-size:.68rem;
  padding:3px 8px;border-radius:4px;text-transform:uppercase;letter-spacing:.04em;font-weight:600;
  white-space:nowrap}
.p-yeni{background:rgba(214,169,40,.24);color:#7A5F10}
.p-arandi{background:rgba(166,111,79,.2);color:#7A4F38}
.p-analiz{background:rgba(138,154,100,.28);color:#3E5237}
.p-sozlesme{background:rgba(96,122,85,.24);color:#3E5237}
.p-uye{background:var(--soil);color:var(--wheat)}
.p-vazgecti{background:rgba(28,38,32,.1);color:rgba(28,38,32,.6)}
.p-uygun-degil{background:rgba(142,74,50,.16);color:var(--alert)}
.dim{color:rgba(28,38,32,.45)}
.state{padding:46px 20px;text-align:center;color:rgba(28,38,32,.6)}
.state h3{margin-bottom:6px;color:var(--ink)}

/* ---------- detay çekmecesi ---------- */
.drawer{position:fixed;inset:0;z-index:60;display:none}
.drawer.on{display:block}
.drawer .veil{position:absolute;inset:0;background:rgba(27,36,30,.45)}
.drawer .panel{position:absolute;right:0;top:0;bottom:0;width:min(520px,100%);background:var(--paper);
  overflow-y:auto;padding:20px 22px 28px;box-shadow:-6px 0 30px rgba(0,0,0,.2)}
.dh{display:flex;align-items:flex-start;gap:12px;margin-bottom:6px}
.dh h2{flex:1}
.dh button{width:32px;height:32px;border-radius:50%;background:rgba(28,38,32,.07);font-size:1rem;
  display:flex;align-items:center;justify-content:center;flex:none}
.dsub{font-family:var(--mono);font-size:.76rem;color:rgba(28,38,32,.55);margin-bottom:16px}
.kv{background:var(--paper2);border:1px solid var(--line);border-radius:8px;padding:4px 14px;
  margin-bottom:14px}
.kv .r{display:flex;gap:12px;padding:9px 0;border-bottom:1px solid var(--line2);font-size:.9rem}
.kv .r:last-child{border-bottom:0}
.kv .r .k{width:120px;flex:none;color:rgba(28,38,32,.6);font-size:.85rem}
.kv .r .v{flex:1;min-width:0;word-break:break-word}
.acts{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.sec{font-family:var(--mono);font-size:.68rem;text-transform:uppercase;letter-spacing:.07em;
  color:var(--clay);font-weight:600;margin:20px 0 8px}
.log{font-size:.85rem}
.log .e{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--line2)}
.log .e:last-child{border-bottom:0}
.log .t{font-family:var(--mono);font-size:.74rem;color:rgba(28,38,32,.5);width:92px;flex:none}
.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%) translateY(140%);
  background:var(--soil);color:var(--paper);padding:12px 20px;border-radius:8px;font-size:.9rem;
  z-index:99;transition:.24s;max-width:92vw}
.toast.on{transform:translateX(-50%) translateY(0)}
.toast.bad{background:var(--alert)}
</style>
</head>
<body>

<!-- ================= GİRİŞ ================= -->
<div class="login-wrap" id="loginWrap">
  <div class="login">
    <div class="head">
      <div class="mark">
        <span class="logo" aria-hidden="true">
          <i style="background:#D8C69A"></i><i style="background:#A66F4F"></i>
          <i style="background:#7A4F38"></i><i style="background:#26342B"></i>
        </span>Topracon Yönetim
      </div>
      <h1>Personel girişi</h1>
      <p>Bu ekran Topracon çalışanları içindir. Çiftçi başvuruları ve kişisel veriler burada görünür.</p>
    </div>
    <div class="body">
      <form id="lf" novalidate>
        <div class="field">
          <label class="f" for="lMail">E-posta</label>
          <input type="email" id="lMail" autocomplete="username" placeholder="ad@topracon.com">
        </div>
        <div class="field">
          <label class="f" for="lPw">Şifre</label>
          <input type="password" id="lPw" autocomplete="current-password">
        </div>
        <button class="btn block" type="submit" id="lBtn" style="margin-top:18px">Giriş yap</button>
      </form>
      <div class="msg bad" id="lMsg"></div>
      <p class="tiny" style="margin-top:16px">Hesabınız yoksa yöneticinizden isteyin. Kendi kendine kayıt kapalıdır ve hesap açmak tek başına veri erişimi vermez.</p>
    </div>
  </div>
</div>

<!-- ================= UYGULAMA ================= -->
<div id="app">
  <div class="bar">
    <div class="bar-in">
      <span class="mark">
        <span class="logo" aria-hidden="true">
          <i style="background:#D8C69A"></i><i style="background:#A66F4F"></i>
          <i style="background:#7A4F38"></i><i style="background:#26342B"></i>
        </span>Topracon Yönetim
      </span>
      <span class="env" id="envTag">canlı veri</span>
      <span class="sp"></span>
      <button onclick="load()" id="rfBtn">Yenile</button>
      <button onclick="csv()">CSV indir</button>
      <span class="me"><b id="meName">—</b><span id="meRole">—</span></span>
      <button onclick="logout()">Çıkış</button>
    </div>
  </div>

  <div class="wrap">
    <div class="kpis" id="kpis"></div>

    <div class="tools">
      <input class="grow" type="search" id="q" placeholder="Ad, telefon, köy veya kooperatif ara…" oninput="draw()">
      <select id="fIl" onchange="draw()"><option value="">Tüm iller</option></select>
      <select id="fOnc" onchange="draw()">
        <option value="">Tüm öncelikler</option>
        <option value="yuksek">Yüksek öncelik</option>
        <option value="normal">Normal</option>
        <option value="dusuk">Düşük</option>
      </select>
      <span class="count" id="cnt"></span>
    </div>

    <div class="tablebox">
      <div class="scroll"><table id="tbl">
        <thead><tr id="thead"></tr></thead>
        <tbody id="tbody"></tbody>
      </table></div>
      <div class="state" id="state" style="display:none"></div>
    </div>
  </div>
</div>

<!-- ================= DETAY ================= -->
<div class="drawer" id="dw">
  <div class="veil" onclick="closeDw()"></div>
  <div class="panel" id="dwPanel"></div>
</div>

<div class="toast" id="toast"></div>

<script>
/* =====================================================================
   SUPABASE AYARI — ciftci.html'deki ile AYNI proje, AYNI anahtar.
   Aynı veritabanından beslenir; başvurular tek yerde durur.
   service_role anahtarını buraya ASLA yazma; gerek de yok.
   ===================================================================== */
var SB_URL = "https://ohqddlnepwueunblkqvo.supabase.co";
var SB_KEY = "sb_publishable_YmWVVy_0Ax3KcOo0oi70MA_ajyWCmpn";
/* ===================================================================== */

var TOKEN=null, ME=null, ROWS=[], sortKey="olusturma", sortDir=-1, fDurum="", selId=null;

var DURUM=[
 ["yeni","Yeni"],["arandi","Arandı"],["analiz","Analizde"],["sozlesme","Sözleşme"],
 ["uye","Üye"],["vazgecti","Vazgeçti"],["uygun-degil","Uygun değil"]
];
var COLS=[
 ["olusturma","Tarih",40],["ad_soyad","Ad soyad",0],["telefon","Telefon",0],
 ["il","İl / ilçe",0],["donum","Dönüm",1],["urun","Ürün",0],
 ["toprak_isleme","Toprak işleme",0],["durum","Durum",0],["atanan_muhendis","Mühendis",0]
];

function el(i){return document.getElementById(i)}
function esc(x){return String(x==null?"":x).replace(/[&<>"]/g,function(c){
  return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function n0(x){return (x==null||x==="")?"—":Number(x).toLocaleString("tr-TR")}
function toast(m,bad){var t=el("toast");t.textContent=m;t.className="toast on"+(bad?" bad":"");
  clearTimeout(t._x);t._x=setTimeout(function(){t.className="toast"+(bad?" bad":"")},3200)}
function dTR(iso){if(!iso)return "—";var d=new Date(iso);
  return d.toLocaleDateString("tr-TR",{day:"2-digit",month:"2-digit",year:"2-digit"})
    +" "+d.toLocaleTimeString("tr-TR",{hour:"2-digit",minute:"2-digit"})}
function durumAd(k){var f=DURUM.filter(function(d){return d[0]===k})[0];return f?f[1]:(k||"—")}

/* -------------------- REST yardımcıları -------------------- */
function api(path,opts){
  opts=opts||{};
  var h={"apikey":SB_KEY,"Content-Type":"application/json"};
  h["Authorization"]="Bearer "+(TOKEN||SB_KEY);
  if(opts.prefer) h["Prefer"]=opts.prefer;
  return fetch(SB_URL.replace(/\/+$/,"")+path,{method:opts.method||"GET",headers:h,body:opts.body})
    .then(function(r){
      if(r.status===401||r.status===403){ throw {auth:true,msg:"Yetki reddedildi"} }
      if(!r.ok) return r.text().then(function(t){ throw {msg:r.status+" "+t} });
      if(r.status===204) return null;
      return r.text().then(function(t){ return t?JSON.parse(t):null });
    });
}

/* -------------------- giriş -------------------- */
el("lf").addEventListener("submit",function(ev){
  ev.preventDefault();
  var mail=el("lMail").value.trim(), pw=el("lPw").value;
  var m=el("lMsg");
  if(!SB_URL||!SB_KEY){
    m.className="msg info on";
    m.innerHTML="Supabase bağlantısı tanımlı değil. Bu dosyanın en üstündeki <b>SB_URL</b> ve <b>SB_KEY</b> satırlarını doldurun.";
    return;
  }
  if(!mail||!pw){ m.className="msg bad on"; m.textContent="E-posta ve şifre gerekli."; return }
  var b=el("lBtn"); b.disabled=true; b.textContent="Giriş yapılıyor…";
  m.className="msg";

  fetch(SB_URL.replace(/\/+$/,"")+"/auth/v1/token?grant_type=password",{
    method:"POST",
    headers:{"apikey":SB_KEY,"Content-Type":"application/json"},
    body:JSON.stringify({email:mail,password:pw})
  })
  .then(function(r){ return r.json().then(function(j){ return {ok:r.ok,j:j} }) })
  .then(function(res){
    if(!res.ok||!res.j.access_token) throw new Error(res.j.error_description||res.j.msg||"Giriş başarısız");
    TOKEN=res.j.access_token;
    /* Personel satırı var mı? Auth'ta hesabı olmak yetmez. */
    return api("/rest/v1/personel?select=ad_soyad,rol,bolge&limit=1");
  })
  .then(function(p){
    if(!p||!p.length){
      TOKEN=null;
      throw new Error("Bu hesap personel olarak tanımlı değil. Yöneticinizle görüşün.");
    }
    ME=p[0];
    el("meName").textContent=ME.ad_soyad;
    el("meRole").textContent=({yonetici:"Yönetici",muhendis:"Ziraat mühendisi",operasyon:"Operasyon"})[ME.rol]
      +(ME.bolge?" · "+ME.bolge:"");
    el("loginWrap").style.display="none";
    el("app").style.display="block";
    load();
  })
  .catch(function(e){
    b.disabled=false; b.textContent="Giriş yap";
    var m=el("lMsg"); m.className="msg bad on";
    m.textContent=(e&&e.message)||"Giriş yapılamadı. E-posta veya şifre hatalı olabilir.";
  });
});

function logout(){
  TOKEN=null; ME=null; ROWS=[];
  el("app").style.display="none";
  el("loginWrap").style.display="flex";
  el("lPw").value="";
  var b=el("lBtn"); b.disabled=false; b.textContent="Giriş yap";
  el("lMsg").className="msg";
}

/* -------------------- veri -------------------- */
function load(){
  var b=el("rfBtn"); b.disabled=true; b.textContent="Yükleniyor…";
  showState("Yükleniyor…","Başvurular getiriliyor.");
  api("/rest/v1/basvuru?select=*&order=olusturma.desc&limit=2000")
    .then(function(rows){
      ROWS=rows||[];
      fillIller();
      draw();
      b.disabled=false; b.textContent="Yenile";
    })
    .catch(function(e){
      b.disabled=false; b.textContent="Yenile";
      if(e&&e.auth){ toast("Oturum düştü, tekrar giriş yapın.",true); logout(); return }
      showState("Veri alınamadı", (e&&e.msg)||"Bağlantıyı ve tablo yetkilerini kontrol edin.");
      toast("Başvurular yüklenemedi.",true);
    });
}

function fillIller(){
  var iller={}; ROWS.forEach(function(r){ if(r.il) iller[r.il]=1 });
  var cur=el("fIl").value;
  el("fIl").innerHTML='<option value="">Tüm iller</option>'
    +Object.keys(iller).sort().map(function(i){return '<option>'+esc(i)+'</option>'}).join("");
  el("fIl").value=cur;
}

function filtered(){
  var q=el("q").value.trim().toLowerCase();
  var il=el("fIl").value, onc=el("fOnc").value;
  var out=ROWS.filter(function(r){
    if(fDurum && r.durum!==fDurum) return false;
    if(il && r.il!==il) return false;
    if(onc && (r.oncelik||"normal")!==onc) return false;
    if(q){
      var hay=[r.ad_soyad,r.telefon,r.ilce,r.kooperatif,r.il].join(" ").toLowerCase();
      if(hay.indexOf(q)<0) return false;
    }
    return true;
  });
  out.sort(function(a,b){
    var x=a[sortKey], y=b[sortKey];
    if(x==null)x=""; if(y==null)y="";
    if(typeof x==="number"||typeof y==="number") return (Number(x)-Number(y))*sortDir;
    return String(x).localeCompare(String(y),"tr")*sortDir;
  });
  return out;
}

function showState(t,s){
  el("state").style.display="block";
  el("state").innerHTML="<h3>"+esc(t)+"</h3><p>"+esc(s)+"</p>";
  el("tbl").style.display="none";
}
function hideState(){ el("state").style.display="none"; el("tbl").style.display=""; }

function kpi(){
  var toplam=ROWS.length, alan=0;
  var sayim={}; DURUM.forEach(function(d){sayim[d[0]]=0});
  ROWS.forEach(function(r){
    if(sayim[r.durum]!==undefined) sayim[r.durum]++;
    if(r.durum!=="vazgecti"&&r.durum!=="uygun-degil") alan+=Number(r.donum||0);
  });
  var cells=[["","Tüm başvurular",toplam,"d-alan"]];
  ["yeni","arandi","analiz","sozlesme","uye"].forEach(function(k){
    cells.push([k,durumAd(k),sayim[k],"d-"+k]);
  });
  var h=cells.map(function(c){
    return '<button class="kpi '+c[3]+'" aria-pressed="'+(fDurum===c[0])+'" onclick="setDurum(\''+c[0]+'\')">'
      +'<div class="v">'+n0(c[2])+'</div><div class="l">'+esc(c[1])+'</div></button>';
  }).join("");
  h+='<div class="kpi d-alan" style="cursor:default"><div class="v">'+n0(alan)
     +'</div><div class="l">aktif hattaki dönüm</div></div>';
  el("kpis").innerHTML=h;
}
function setDurum(k){ fDurum=(fDurum===k?"":k); draw() }

function draw(){
  kpi();
  var rows=filtered();
  el("cnt").textContent=rows.length+" / "+ROWS.length+" kayıt";
  el("thead").innerHTML=COLS.map(function(c){
    var ar=sortKey===c[0]?(sortDir>0?"▲":"▼"):'<span class="ar">↕</span>';
    return '<th onclick="sortBy(\''+c[0]+'\')"'+(c[2]===1?' class="r"':'')+'>'+esc(c[1])+' '+ar+'</th>';
  }).join("");

  if(!ROWS.length){ showState("Henüz başvuru yok","Çiftçi sayfasındaki form dolduruldukça kayıtlar buraya düşer."); return }
  if(!rows.length){ showState("Filtreye uyan kayıt yok","Aramayı veya durum filtresini temizleyin."); return }
  hideState();

  el("tbody").innerHTML=rows.map(function(r){
    var onc=(r.oncelik==="yuksek")?' <span class="pill p-uygun-degil">öncelik</span>':'';
    return '<tr onclick="openRow(\''+r.id+'\')" class="'+(selId===r.id?"sel":"")+'">'
      +'<td class="nowrap num dim">'+dTR(r.olusturma)+'</td>'
      +'<td><b>'+esc(r.ad_soyad)+'</b>'+onc+'</td>'
      +'<td class="nowrap num">'+esc(r.telefon)+'</td>'
      +'<td class="nowrap">'+esc(r.il||"—")+(r.ilce?' <span class="dim">/ '+esc(r.ilce)+'</span>':'')+'</td>'
      +'<td class="r num">'+n0(r.donum)+'</td>'
      +'<td>'+esc(r.urun||"—")+'</td>'
      +'<td class="dim">'+esc(r.toprak_isleme||"—")+'</td>'
      +'<td><span class="pill p-'+esc(r.durum||"yeni")+'">'+esc(durumAd(r.durum))+'</span></td>'
      +'<td>'+esc(r.atanan_muhendis||"—")+'</td></tr>';
  }).join("");
}
function sortBy(k){ if(sortKey===k) sortDir=-sortDir; else {sortKey=k; sortDir=(k==="olusturma"?-1:1)} draw() }

/* -------------------- detay -------------------- */
function openRow(id){
  var r=ROWS.filter(function(x){return x.id===id})[0];
  if(!r) return;
  selId=id; draw();
  var tel=(r.telefon||"").replace(/\D/g,"");
  var wa=tel.length>=10?("90"+tel.slice(-10)):"";
  el("dwPanel").innerHTML=
     '<div class="dh"><h2>'+esc(r.ad_soyad)+'</h2>'
    +'<button onclick="closeDw()" aria-label="Kapat">✕</button></div>'
    +'<p class="dsub">'+dTR(r.olusturma)+' · '+esc(r.kaynak||"—")+'</p>'

    +'<div class="acts">'
    +(tel?'<a class="btn sm soil" href="tel:+'+esc(wa)+'">Ara</a>':'')
    +(wa&&r.whatsapp?'<a class="btn sm ghost" href="https://wa.me/'+esc(wa)+'" target="_blank" rel="noopener">WhatsApp</a>':'')
    +'</div>'

    +'<div class="kv">'
    +row("Telefon",'<span class="num">'+esc(r.telefon)+'</span>'+(r.whatsapp?' <span class="pill p-analiz">whatsapp ok</span>':''))
    +row("İl / ilçe",esc(r.il||"—")+(r.ilce?" / "+esc(r.ilce):""))
    +row("Alan",'<span class="num">'+n0(r.donum)+'</span> dönüm')
    +row("Ana ürün",esc(r.urun||"—"))
    +row("Toprak işleme",esc(r.toprak_isleme||"—"))
    +row("Mibzer",esc(r.mibzer||"—"))
    +row("Şu an yaptıkları",esc(r.mevcut_uygulamalar||"—"))
    +row("Kooperatif",esc(r.kooperatif||"—"))
    +row("Çiftçinin notu",esc(r.not_metni||"—"))
    +row("KVKK onayı",r.kvkk_onay?"verildi":'<span style="color:var(--alert)">yok</span>')
    +'</div>'

    +'<div class="sec">Operasyon</div>'
    +'<div class="field"><label class="f" for="dDurum">Durum</label><select id="dDurum">'
      +DURUM.map(function(d){return '<option value="'+d[0]+'"'+(r.durum===d[0]?" selected":"")+'>'+d[1]+'</option>'}).join("")
    +'</select></div>'
    +'<div class="field"><label class="f" for="dOnc">Öncelik</label><select id="dOnc">'
      +[["yuksek","Yüksek"],["normal","Normal"],["dusuk","Düşük"]].map(function(o){
        return '<option value="'+o[0]+'"'+((r.oncelik||"normal")===o[0]?" selected":"")+'>'+o[1]+'</option>'}).join("")
    +'</select></div>'
    +'<div class="field"><label class="f" for="dMuh">Atanan mühendis</label>'
      +'<input type="text" id="dMuh" value="'+esc(r.atanan_muhendis||"")+'" placeholder="'+esc(ME?ME.ad_soyad:"")+'"></div>'
    +'<div class="field"><label class="f" for="dArama">Görüşme tarihi</label>'
      +'<input type="date" id="dArama" value="'+esc(r.arama_tarihi||"")+'"></div>'
    +'<div class="field"><label class="f" for="dNot">Görüşme notu</label>'
      +'<textarea id="dNot" placeholder="Ne konuşuldu, ne karar verildi, sonraki adım ne?">'+esc(r.gorusme_notu||"")+'</textarea></div>'
    +'<div class="acts" style="margin-top:16px">'
      +'<button class="btn" id="dSave" onclick="save(\''+r.id+'\')">Kaydet</button>'
      +'<button class="btn ghost" onclick="closeDw()">Kapat</button>'
    +'</div>'
    +(r.guncelleyen_ad?'<p class="tiny">Son değişiklik: '+esc(r.guncelleyen_ad)+' · '+dTR(r.guncelleme)+'</p>':'')
    +'<div class="sec">Değişiklik geçmişi</div><div class="log" id="dLog"><p class="tiny">Yükleniyor…</p></div>';
  el("dw").classList.add("on");
  loadLog(r.id);
}
function row(k,v){ return '<div class="r"><span class="k">'+k+'</span><span class="v">'+v+'</span></div>' }
function closeDw(){ el("dw").classList.remove("on"); selId=null; draw() }

function loadLog(id){
  api("/rest/v1/basvuru_log?select=*&basvuru_id=eq."+id+"&order=ne_zaman.desc&limit=40")
    .then(function(l){
      if(!l||!l.length){ el("dLog").innerHTML='<p class="tiny">Henüz değişiklik yok.</p>'; return }
      el("dLog").innerHTML=l.map(function(e){
        return '<div class="e"><span class="t">'+dTR(e.ne_zaman)+'</span>'
          +'<span><b>'+esc(e.kim_ad||"—")+'</b> · '+esc(e.alan)+': '
          +'<span class="dim">'+esc(e.eski_deger||"boş")+'</span> → '+esc(e.yeni_deger||"boş")+'</span></div>';
      }).join("");
    })
    .catch(function(){ el("dLog").innerHTML='<p class="tiny">Geçmiş alınamadı.</p>' });
}

function save(id){
  var b=el("dSave"); b.disabled=true; b.textContent="Kaydediliyor…";
  var body={
    durum:el("dDurum").value,
    oncelik:el("dOnc").value,
    atanan_muhendis:el("dMuh").value.trim()||null,
    arama_tarihi:el("dArama").value||null,
    gorusme_notu:el("dNot").value.trim()||null
  };
  api("/rest/v1/basvuru?id=eq."+id,{method:"PATCH",body:JSON.stringify(body),prefer:"return=representation"})
    .then(function(res){
      var upd=res&&res[0];
      if(upd){ ROWS=ROWS.map(function(r){ return r.id===id?upd:r }) }
      toast("Kaydedildi.");
      b.disabled=false; b.textContent="Kaydet";
      draw(); if(upd) openRow(id);
    })
    .catch(function(e){
      b.disabled=false; b.textContent="Kaydet";
      if(e&&e.auth){ toast("Yetkiniz yok ya da oturum düştü.",true); return }
      toast("Kaydedilemedi: "+((e&&e.msg)||"bilinmeyen hata"),true);
    });
}

/* -------------------- CSV -------------------- */
function csv(){
  var rows=filtered();
  if(!rows.length){ toast("İndirilecek kayıt yok.",true); return }
  var head=["tarih","ad_soyad","telefon","il","ilce","donum","urun","toprak_isleme","mibzer",
            "mevcut_uygulamalar","kooperatif","not_metni","whatsapp","durum","oncelik",
            "atanan_muhendis","arama_tarihi","gorusme_notu"];
  function q(v){ v=(v==null?"":String(v)); return '"'+v.replace(/"/g,'""')+'"' }
  var out=[head.join(";")].concat(rows.map(function(r){
    return [dTR(r.olusturma),r.ad_soyad,r.telefon,r.il,r.ilce,r.donum,r.urun,r.toprak_isleme,
            r.mibzer,r.mevcut_uygulamalar,r.kooperatif,r.not_metni,r.whatsapp?"evet":"hayır",
            durumAd(r.durum),r.oncelik,r.atanan_muhendis,r.arama_tarihi,r.gorusme_notu].map(q).join(";");
  })).join("\r\n");
  /* Excel'in Türkçe karakterleri doğru okuması için BOM */
  var blob=new Blob(["\uFEFF"+out],{type:"text/csv;charset=utf-8"});
  var a=document.createElement("a");
  a.href=URL.createObjectURL(blob);
  a.download="topracon-basvurular-"+new Date().toISOString().slice(0,10)+".csv";
  a.click(); URL.revokeObjectURL(a.href);
  toast(rows.length+" kayıt indirildi.");
}

document.addEventListener("keydown",function(e){ if(e.key==="Escape") closeDw() });
if(!SB_URL||!SB_KEY){ el("envTag").textContent="bağlantı yok"; }
</script>
</body>
