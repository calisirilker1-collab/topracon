function yeniToprakNumunesi(){drawer("Toprak numunesi","Bu ilk sürüm tarayıcıda tutulur; üretimde gerçek sample/lab tablosuna taşınmalıdır.",selParsel("tsP","")+inp("tsId","Numune ID *","")+inp("tsDate","Numune tarihi",bugun(),"date")+'<div class="f2">'+inp("tsDepth","Derinlik","0-30 cm")+inp("tsSoc","SOC %","")+inp("tsBd","Bulk density g/cm³","")+inp("tsLab","Laboratuvar","")+'</div>'+inp("tsMethod","Analiz yöntemi","dry combustion")+txt("tsNote","Not","")+'<div class="acts" style="margin-top:16px"><button class="btn" id="dSave" onclick="saveToprak()">Kaydet</button><button class="btn ghost" onclick="closeDw()">Vazgeç</button></div>')}
function saveToprak(){var p=el("tsP").value,id=el("tsId").value.trim();if(!p||!id){toast("Parsel ve numune ID zorunlu.",true);return}var a=mrvSoil();a.push({parsel_id:p,sample_id:id,date:el("tsDate").value,depth:el("tsDepth").value,soc:el("tsSoc").value,bd:el("tsBd").value,lab:el("tsLab").value,method:el("tsMethod").value,note:el("tsNote").value,status:(el("tsSoc").value&&el("tsBd").value&&el("tsLab").value)?"tam":"eksik"});saveMrvSoil(a);closeDw();toast("Numune kaydedildi.");drawSoil();drawMRV()}
function drawHesap(){var rows=PARSEL.filter(function(p){return p.durum!=="pasif"}),area=0,est=0;el("calcBody").innerHTML=rows.map(function(p){var s=parcelStats(p),a=Number(p.donum||0),soc=s.soil.length?Number(s.soil[s.soil.length-1].soc||0):0,op=soc*a*.1,ready=s.boundary&&s.history&&s.verified&&s.soil.length;area+=a;est+=op;return '<tr><td><b>'+esc(p.ad)+'</b></td><td class="r num">'+n1(a)+'</td><td>'+pill(ready?'uyumlu':'celiski',ready?'Hazır':'Eksik')+'</td><td class="r num">'+s.acts.length+'</td><td class="r num">'+(soc?soc.toLocaleString('tr-TR',{maximumFractionDigits:2})+' %':'—')+'</td><td class="r num">'+(op?op.toLocaleString('tr-TR',{maximumFractionDigits:1}):'—')+'</td><td>'+pill(ready?'uyumlu':'celiski',ready?'Hesaplanabilir':'Bekliyor')+'</td></tr>'}).join("");el("calcKpi").innerHTML=kpiBox(n1(area),"toplam dönüm","k-field")+kpiBox(n1(est),"operasyonel tahmin CO₂e","k-analiz")+kpiBox(rows.filter(function(p){var s=parcelStats(p);return s.boundary&&s.history&&s.verified&&s.soil.length}).length,"hesaba hazır parsel","k-uye")}
function drawDenetim(){var ps=PARSEL.filter(function(p){return p.durum!=="pasif"}),checks=[['Parsel sınırı / alan',ps.filter(function(p){return parcelStats(p).boundary}).length,ps.length],['Baseline tarihçesi',ps.filter(function(p){return parcelStats(p).history}).length,ps.length],['Aktivite doğrulaması',ps.filter(function(p){return parcelStats(p).verified}).length,ps.length],['Toprak numunesi',ps.filter(function(p){return parcelStats(p).soil.length}).length,ps.length]],done=checks.reduce(function(a,x){return a+x[1]},0),all=checks.reduce(function(a,x){return a+x[2]},0);el("auditKpi").innerHTML=kpiBox(all?Math.round(done/all*100):0,"hazırlık skoru %","k-analiz")+kpiBox(all-done,"eksik kontrol","k-alert")+kpiBox(AKTIVITE.filter(function(a){return a.dogrulama==="celiski"}).length,"açık bulgu","k-alert");el("auditList").innerHTML=checks.map(function(x){var pct=x[2]?Math.round(x[1]/x[2]*100):100;return '<div style="padding:10px 0;border-bottom:1px solid var(--line2)"><b>'+x[0]+'</b><span class="dim" style="float:right">'+x[1]+'/'+x[2]+'</span><div class="progress"><i style="width:'+pct+'%"></i></div></div>'}).join("");el("auditFindings").innerHTML=AKTIVITE.filter(function(a){return a.dogrulama==="celiski"}).slice(0,12).map(function(a){var p=parselOf(a.parsel_id);return '<div style="padding:8px 0;border-bottom:1px solid var(--line2)"><b>'+esc(p?p.ad:'—')+'</b> · '+esc(a.tip)+'<div class="tiny">'+esc(a.dogrulama_notu||'Doğrulama notu girilmemiş.')+'</div></div>'}).join("")||'<p class="tiny">Açık çelişki yok.</p>'}
function drawKarbonViews(){drawMRV();drawUygunluk();drawBaseline();drawSoil();drawHesap();drawDenetim()}

/* ---------- çekmece / form ---------- */
function drawer(bas,alt,gov){
  el("dwPanel").innerHTML='<div class="dh"><h2>'+bas+'</h2><button onclick="closeDw()" aria-label="Kapat">✕</button></div>'
    +'<p class="dsub">'+alt+'</p>'+gov;
  el("dw").classList.add("on");
}
function closeDw(){el("dw").classList.remove("on")}
function kvr(k,v){return '<div class="r"><span class="k">'+k+'</span><span class="v">'+v+'</span></div>'}
function inp(id,lab,val,tip,ph){
  return '<div class="field"><label class="f" for="'+id+'">'+lab+'</label><input type="'+(tip||"text")
    +'" id="'+id+'" value="'+esc(val==null?"":val)+'"'+(ph?' placeholder="'+esc(ph)+'"':'')+'></div>'}
function txt(id,lab,val,ph){
  return '<div class="field"><label class="f" for="'+id+'">'+lab+'</label><textarea id="'+id+'"'
    +(ph?' placeholder="'+esc(ph)+'"':'')+'>'+esc(val||"")+'</textarea></div>'}
function sel(id,lab,opts,cur){
  return '<div class="field"><label class="f" for="'+id+'">'+lab+'</label><select id="'+id+'">'
    +opts.map(function(o){return '<option value="'+o[0]+'"'+(String(cur)===String(o[0])?" selected":"")+'>'+o[1]+'</option>'}).join("")+'</select></div>'}
function selRaw(id,lab,arr,cur){
  return '<div class="field"><label class="f" for="'+id+'">'+lab+'</label><select id="'+id+'">'
    +arr.map(function(o){return '<option'+(cur===o?" selected":"")+'>'+esc(o)+'</option>'}).join("")+'</select></div>'}
function selCiftci(id,cur){
  return '<div class="field"><label class="f" for="'+id+'">Çiftçi</label><select id="'+id+'">'
    +CIFTCI.map(function(c){return '<option value="'+c.id+'"'+(cur===c.id?" selected":"")+'>'+esc(c.ad_soyad)
      +(c.ilce?" · "+esc(c.ilce):"")+'</option>'}).join("")+'</select></div>'}
function selParsel(id,cur){
  return '<div class="field"><label class="f" for="'+id+'">Parsel</label><select id="'+id+'">'
    +PARSEL.map(function(p){return '<option value="'+p.id+'"'+(cur===p.id?" selected":"")+'>'+esc(p.ad)
      +" · "+esc(ciftciAd(p.ciftci_id))+'</option>'}).join("")+'</select></div>'}

/* ---------- CSV ---------- */
function indir(ad,head,rows){
  function q(v){v=(v==null?"":String(v));return '"'+v.replace(/"/g,'""')+'"'}
  var out=[head.join(";")].concat(rows.map(function(r){return r.map(q).join(";")})).join("\r\n");
  var a=document.createElement("a");
  a.href=URL.createObjectURL(new Blob(["\uFEFF"+out],{type:"text/csv;charset=utf-8"}));
  a.download=ad+"-"+bugun()+".csv";a.click();URL.revokeObjectURL(a.href);
  toast(rows.length+" satır indirildi.");
}
function csvBasvuru(){
  if(!BASVURU.length){toast("İndirilecek kayıt yok.",true);return}
  indir("topracon-basvurular",["tarih","ad_soyad","telefon","il","ilce","donum","urun","toprak_isleme",
    "mibzer","mevcut_uygulamalar","kooperatif","not","whatsapp","durum","oncelik","muhendis","arama","gorusme_notu"],
    BASVURU.map(function(r){return [dTR(r.olusturma),r.ad_soyad,r.telefon,r.il,r.ilce,r.donum,r.urun,
      r.toprak_isleme,r.mibzer,r.mevcut_uygulamalar,r.kooperatif,r.not_metni,r.whatsapp?"evet":"hayır",
      durumAd(r.durum),r.oncelik,r.atanan_muhendis,r.arama_tarihi,r.gorusme_notu]}));
}
function csvOdeme(){
  if(!ODEME.length){toast("İndirilecek kayıt yok.",true);return}
  indir("topracon-odemeler",["planlanan","ciftci","tip","aciklama","tutar","odenen","durum","dekont"],
    ODEME.map(function(o){return [o.planlanan_tarih,ciftciAd(o.ciftci_id),o.tip,o.aciklama,o.tutar,
      o.odenen_tarih,o.durum,o.dekont_no]}));
}

document.addEventListener("keydown",function(e){if(e.key==="Escape")closeDw()});
