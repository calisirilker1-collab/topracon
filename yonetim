<script>
/* ===== SUPABASE — ciftci.html ile AYNI proje, AYNI veritabanı ===== */
var SB_URL = "https://ohqddlnepwueunblkqvo.supabase.co";
var SB_KEY = "sb_publishable_YmWVVy_0Ax3KcOo0oi70MA_ajyWCmpn";
/* ================================================================= */

var TOKEN=null, ME=null;
var BASVURU=[],CIFTCI=[],PARSEL=[],AKTIVITE=[],ODEME=[],PERSONEL=[],PARAM=[];
var bSort="olusturma", bDir=-1, bDurum="";

var DURUM=[["yeni","Yeni"],["arandi","Arandı"],["analiz","Analizde"],["sozlesme","Sözleşme"],
           ["uye","Üye"],["vazgecti","Vazgeçti"],["uygun-degil","Uygun değil"]];
var TIPLER=["Ekim","Örtü bitkisi ekimi","Toprak işleme","Gübreleme","İlaçlama","Hasat","Anız yönetimi","Otlatma","Diğer"];
var MENU=[["ozet","Genel bakış","ana"],["basvuru","Başvurular","ana"],
           ["ciftci","Üye çiftçiler","saha"],["parsel","Parseller","saha"],
           ["defter","Tarla defteri","saha"],["odeme","Ödemeler","saha"],
           ["mrv","MRV / Karbon","karbon"],["uygunluk","Uygunluk","karbon"],
           ["baseline","Baseline","karbon"],["toprak","Toprak numuneleri","karbon"],
           ["hesap","Karbon hesabı","karbon"],["denetim","Doğrulama hazırlığı","karbon"],
