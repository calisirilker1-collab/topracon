    return '<tr onclick="openBasvuru(\''+r.id+'\')"><td class="nowrap num dim">'+dTR(r.olusturma)+'</td>'
      +'<td><b>'+esc(r.ad_soyad)+'</b>'+o+'</td><td class="nowrap num">'+esc(r.telefon)+'</td>'
      +'<td class="nowrap">'+esc(r.il||"—")+(r.ilce?' <span class="dim">/ '+esc(r.ilce)+'</span>':'')+'</td>'
      +'<td class="r num">'+n0(r.donum)+'</td><td>'+esc(r.urun||"—")+'</td>'
      +'<td class="dim">'+esc(r.toprak_isleme||"—")+'</td><td>'+pill(r.durum,durumAd(r.durum))+'</td>'
      +'<td>'+esc(r.atanan_muhendis||"—")+'</td></tr>'}).join("");
}
