function parcelStats(p){var acts=AKTIVITE.filter(function(a){return a.parsel_id===p.id});var verified=acts.length>0&&acts.every(function(a){return ["uyumlu","muaf"].indexOf(a.dogrulama)>=0});var soil=mrvSoil().filter(function(x){return x.parsel_id===p.id});var history=acts.some(function(a){var y=new Date(a.tarih||0).getFullYear();return y&&y<=2025});var recent=acts.some(function(a){return new Date(a.tarih||0).getFullYear()>=2026});return {acts:acts,verified:verified,soil:soil,boundary:Number(p.donum||0)>0,history:history,recent:recent}}
function drawMRV(){var ps=PARSEL.filter(function(p){return p.durum!=="pasif"}),ready=ps.filter(function(p){var s=parcelStats(p);return s.boundary&&s.history&&s.verified&&s.soil.length}).length,conf=AKTIVITE.filter(function(a){return a.dogrulama==="celiski"}).length;el("mrvKpi").innerHTML=kpiBox(ps.length,"kapsamdaki parsel","k-field")+kpiBox(ready,"MRV hazır","k-uye")+kpiBox(conf,"açık uydu çelişkisi","k-alert")+kpiBox(mrvSoil().length,"toprak numunesi","k-analiz");el("mrvFlow").innerHTML='<div class="flow">'+["Çiftçi","Parsel","Uygunluk","Baseline","Toprak","Aktivite","Uydu","Kanıt","Hesap","VVB"].map(function(x,i){return '<span>'+(i?'<b>→</b> ':'')+esc(x)+'</span>'}).join("")+'</div>';var issues=[];if(ps.some(function(p){return !parcelStats(p).history}))issues.push("Baseline tarihçesi eksik parseller var.");if(ps.some(function(p){return !parcelStats(p).soil.length}))issues.push("Toprak numunesi olmayan parseller var.");if(conf)issues.push(conf+" adet uydu çelişkisi çözülmeli.");el("mrvIssues").innerHTML=issues.length?issues.map(function(x){return '<div style="padding:8px 0;border-bottom:1px solid var(--line2)">⚠ '+esc(x)+'</div>'}).join(""):'<p class="tiny">Kritik açık görünmüyor.</p>';el("mrvBody").innerHTML=ps.map(function(p){var s=parcelStats(p),score=[s.boundary,s.history,s.verified,s.soil.length>0].filter(Boolean).length;return '<tr onclick="openParsel(\''+p.id+'\')"><td><b>'+esc(p.ad)+'</b></td><td>'+esc(ciftciAd(p.ciftci_id))+'</td><td class="r num">'+n1(p.donum)+'</td><td>'+pill(s.boundary?'uyumlu':'celiski',s.boundary?'Hazır':'Eksik')+'</td><td>'+pill(s.history?'uyumlu':'celiski',s.history?'Var':'Eksik')+'</td><td>'+pill(s.verified?'uyumlu':'celiski',s.verified?'Doğrulandı':'Bekliyor')+'</td><td>'+pill(s.soil.length?'uyumlu':'celiski',s.soil.length?'Var':'Eksik')+'</td><td><div class="progress"><i style="width:'+(score*25)+'%"></i></div><span class="tiny">'+score*25+'%</span></td></tr>'}).join("")}
function drawUygunluk(){var q=(el("uyQ").value||"").toLowerCase(),f=el("uyFilter").value,rows=PARSEL.filter(function(p){var s=parcelStats(p),ok=s.boundary&&s.history&&s.recent;if(f==="hazir"&&!ok)return false;if(f==="eksik"&&ok)return false;return !q||[p.ad,ciftciAd(p.ciftci_id),p.ilce,p.koy].join(" ").toLowerCase().indexOf(q)>=0});el("uyCnt").textContent=rows.length+" / "+PARSEL.length;el("uyBody").innerHTML=rows.map(function(p){var s=parcelStats(p),ok=s.boundary&&s.history&&s.recent;return '<tr><td><b>'+esc(p.ad)+'</b></td><td>'+esc(ciftciAd(p.ciftci_id))+'</td><td class="r num">'+n1(p.donum)+'</td><td>'+pill(s.boundary?'uyumlu':'celiski',s.boundary?'Var':'Eksik')+'</td><td>'+pill(s.history?'uyumlu':'celiski',s.history?'Var':'Eksik')+'</td><td>'+pill(s.recent?'uyumlu':'celiski',s.recent?'Var':'Yok')+'</td><td>'+pill(ok?'uyumlu':'celiski',ok?'Hazır':'Eksik')+'</td></tr>'}).join("")}
function drawBaseline(){var rows=PARSEL.filter(function(p){return p.durum!=="pasif"}),complete=0;el("baseBody").innerHTML=rows.map(function(p){var s=parcelStats(p),ys=[2023,2024,2025].map(function(y){return s.acts.some(function(a){return new Date(a.tarih||0).getFullYear()===y})});if(ys.filter(Boolean).length>=2)complete++;return '<tr><td><b>'+esc(p.ad)+'</b></td>'+ys.map(function(v){return '<td>'+pill(v?'uyumlu':'celiski',v?'Kayıt var':'Eksik')+'</td>'}).join('')+'<td>'+pill(s.history?'uyumlu':'celiski',s.history?'Var':'Eksik')+'</td><td>—</td><td>—</td><td>'+pill(s.history?'uyumlu':'celiski',s.history?'İç kanıt':'Eksik')+'</td></tr>'}).join("");el("baseKpi").innerHTML=kpiBox(rows.length,"parsel","k-field")+kpiBox(complete,"tarihçesi güçlü","k-analiz")+kpiBox(rows.length-complete,"eksik / zayıf","k-alert")}
